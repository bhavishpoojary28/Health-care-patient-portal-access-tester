# Healthcare Patient Portal & Access Tester Configuration

PORT=5000
NODE_ENV=development

# MongoDB Connection String (defaults to local MongoDB; automatically falls back to in-memory MongoDB if unavailable)
MONGODB_URI=mongodb://127.0.0.1:27017/healthcare_portal

# JWT Authentication Secret Key
JWT_SECRET=healthcare_portal_super_secret_jwt_key_2026

# Client URL (for CORS if running separately)
CLIENT_URL=http://localhost:5173
